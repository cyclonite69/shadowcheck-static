# ShadowCheck Test/Sandbox Database Runtime Environment Configuration
# Copy this file to .env.test or append these options to your local env overrides.
# This file is used to configure the test runtime stack (ports, DB targets, and isolation).

# Database target (MUST be shadowcheck_test to prevent writing to production)
DB_NAME=shadowcheck_test

# Local dev server port (the host port mapped to the test api)
PORT=3002

# Redis DB isolation (use DB index 1 for sandbox to prevent cache/session pollution)
REDIS_DB=1

# Session cookie isolation (prevents login collision with the main app)
SESSION_COOKIE_NAME=shadowcheck_session_test

# Enable persistent visual banner in the UI
VITE_TEST_DB_BANNER=true

# Mapbox settings for sandbox geospatial views (local mock defaults)
MAPBOX_TOKEN=pk.your_mapbox_token_here
GOOGLE_MAPS_API_KEY=replace_me
WIGLE_API_NAME=replace_me
WIGLE_API_TOKEN=replace_me
